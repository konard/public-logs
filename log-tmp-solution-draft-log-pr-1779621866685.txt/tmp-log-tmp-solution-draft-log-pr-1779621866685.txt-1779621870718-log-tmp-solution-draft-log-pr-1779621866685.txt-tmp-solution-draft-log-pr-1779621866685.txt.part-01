dies/pull-request-234/README.md`\nEOF\ngh pr edit 234 --repo link-assistant/formal-ai --body-file /tmp/pr-234-body.md","workdir":"/tmp/gh-issue-solver-1779619009345","yield_time_ms":1000,"max_output_tokens":12000} thread_id=019e598f-54fa-7c70-a183-b2b9d0dc6521
