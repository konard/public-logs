[2026-06-15T19:14:08.643Z] [INFO] {"type":"item.completed","item":{"id":"item_638","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' src/web/i18n-catalog.lino\"","aggregated_output":"# UI translations for the browser demo, parsed by lino-i18n at runtime.\n# Keep locale blocks in sync; tests/e2e/scripts/check-i18n-catalog.mjs enforces key parity.\n\nen\n  buttons\n    reportIssue \"Report issue\"\n    reportMissingRule \"Report missing rule\"\n    sourceCode \"Source code\"\n    download \"Download\"\n    exportMemory \"Export memory\"\n    importMemory \"Import memory\"\n    resetMemory \"Reset memory\"\n    diagnostics \"Diagnostics\"\n    diagnosticsOn \"Diagnostics on\"\n    agent \"Agent\"\n    chat \"Chat\"\n    demo \"Demo\"\n    demoOn \"Demo on\"\n    openMenu \"Open menu\"\n    closeMenu \"Close menu\"\n    attachFiles \"Attach files\"\n    composerMenu \"Composer menu\"\n    collapseSidebar \"Collapse side panel\"\n    expandSidebar \"Expand side panel\"\n  titles\n    reportIssue \"\"\"\n      Report issue - open a pre-filled GitHub issue with the current session transcript. See docs/upload-memory.md for how to attach the full memory export (Gist or .zip).\n    \"\"\"\n    sourceCode \"Open the formal-ai source code on GitHub.\"\n    download \"Download formal-ai Desktop for macOS, Windows, and Linux.\"\n    exportMemory \"\"\"\n      Export memory - save the full agent state to formal-ai-memory.lino: the entire seed, UI preferences, environment metadata, and the append-only event log. See docs/upload-memory.md for attaching it to a GitHub issue (Gist or .zip).\n    \"\"\"\n    importMemory \"\"\"\n      Import memory - load a previous export. Accepts both the new full-memory bundle and the legacy demo_memory event-only log. Migration hints are shown next to this bar.\n    \"\"\"\n    resetMemory \"\"\"\n      Reset memory - permanently delete the local event log after an export warning and confirmation. The built-in seed remains available.\n    \"\"\"\n    diagnosticsShow \"Show reasoning trace, intent, evidence, and thinking-steps panels.\"\n    diagnosticsHide \"Hide reasoning trace, intent, evidence, and thinking-steps panels.\"\n    agentOn \"Agent mode is on - switch back to single-turn chat.\"\n    agentOff \"\"\"\n      Chat mode - switch to agent mode and each message will be decomposed into sequential steps and executed as a plan.\n    \"\"\"\n    demoOn \"Demo is on - stop the scripted dialog and resume manual chat.\"\n    demoOff \"Start the scripted demo dialog.\"\n    menuOpen \"Open the side panel (conversations, prompts, tools).\"\n    menuClose \"Close the side panel (conversations, prompts, tools).\"\n    composerMenu \"Open input actions for attachments, memory, and reporting.\"\n    resizeSidebar \"Resize the side panel.\"\n    collapseSidebar \"Hide the side panel (more space for the chat).\"\n    expandSidebar \"Show the side panel (conversations, prompts, tools).\"\n  composer\n    placeholder\n      chat \"Message formal-ai\"\n      agent \"Describe a multi-step task (separate steps with ; or 'then')\"\n    demoHint\n      before \"Demo is running - tap \"\n      after \" to stop and type your own message.\"\n    send \"Send\"\n    sending \"Sending...\"\n    attachments \"{count} attached\"\n  conversation\n    new \"+ New conversation\"\n    empty \"Start a new conversation.\"\n    deletedEmpty \"No deleted conversations.\"\n    emptyTitle \"(empty)\"\n    messageCount \"{count} msg\"\n    showDeleted \"Show deleted conversations\"\n    delete \"Delete conversation\"\n    deletePermanent \"Delete permanently\"\n    purgeDeleted \"Purge deleted\"\n    purgeDeletedTitle \"Permanently delete every event from deleted conversations.\"\n    copyMarkdown \"Copy\"\n    copyMarkdownDone \"Copied\"\n    copyMarkdownTitle \"Copy the whole conversation as Markdown\"\n  message\n    author\n      user \"You\"\n    copyCode \"Copy\"\n    copyCodeDone \"Copied!\"\n    copyCodeTitle \"Copy code to clipboard\"\n    copyMarkdown \"Copy as Markdown\"\n    copyMarkdownDone \"Copied!\"\n    copyMarkdownTitle \"Copy the whole message as Markdown\"\n    thinking \"Thinking\"\n    thinkingExpand \"Expand\"\n    thinkingCollapse \"Collapse\"\n    thinkingPrevious \"Previous thinking step\"\n    thinkingCurrent \"Current thinking step\"\n    thinkingLanguage\n      en \"English\"\n      ru \"Russian\"\n      zh \"Chinese\"\n      hi \"Hindi\"\n      unknown \"the prompt language\"\n    thinkingRoute\n      reply \"reply\"\n      greeting \"greeting response\"\n      farewell \"farewell response\"\n      unknown \"fallback response\"\n      generic \"{route} response\"\n    thinkingRule\n      selected \"selected\"\n      greeting \"greeting\"\n      farewell \"farewell\"\n      unknown \"fallback\"\n    thinkingStep\n      impulse \"Received the user request.\"\n      formalize \"Identified the request type.\"\n      formalizeResolved \"Filled in the specific subject.\"\n      detectLanguage \"Detected {language} as the prompt language.\"\n      resolveResponseLanguage \"Selected {language} for the answer.\"\n      clarifyFormalization \"Prepared a clarification because the request had multiple likely meanings.\"\n      dispatchHandler \"Chose the {route}.\"\n      matchRule \"Matched the {rule} rule.\"\n      invokeTool \"Checked the {tool} capability.\"\n      fallback \"Used the unknown-request fallback because no more specific rule matched.\"\n      userContext \"Applied available context: {context}.\"\n      deformalize \"Prepared the answer in readable text.\"\n      routeAttempt \"Tried the {route}.\"\n      coreferenceBinding \"Linked the follow-up wording to the earlier subject.\"\n      modifierDetection \"Detected request modifiers.\"\n      ruleConstruction \"Built a local behavior rule.\"\n      ruleVerification \"Verified the local behavior rule.\"\n      programPlan \"Planned the requested program shape.\"\n      desktopShell \"Checked the desktop bridge status.\"\n      httpChat \"Sent the request to the local desktop chat endpoint.\"\n      memory \"Kept memory import/export on the local bundle.\"\n      agentPlan \"Added a task to the agent plan.\"\n      agentSubstep \"{summary}\"\n      triggerButton \"Triggered the {action} control.\"\n      applyMessageCommand \"Applied the message command: {command}.\"\n      triggerMessageAction \"Prepared the requested action: {action}.\"\n      extractTerm \"Extracted the recall search term.\"\n      scanMemory \"Scanned stored conversation memory.\"\n      groupByConversation \"Grouped matching memories by conversation.\"\n      generic \"Handled {step}{detail}.\"\n      working \"Working through the request.\"\n      fallbackNormalize \"Normalized the prompt text.\"\n      fallbackIntent \"Selected the {intent} response type.\"\n      fallbackRender \"Prepared a deterministic answer from {source}.\"\n    diagnosticsSteps \"Reasoning steps\"\n    diagnosticsTools \"Tool calls\"\n    toolInputs \"Inputs\"\n    toolOutputs \"Outputs\"\n    toolReasoning \"Tool reasoning\"\n    formalization \"Formalization\"\n    formalizationSubjectVerbObject \"Subject - Verb - Object\"\n    otherSources \"Other sources\"\n    sourceCounts \"{count} source(s)\"\n    diagnosticsHttp \"Raw HTTP exchanges\"\n    diagnosticsHttpRequest \"Request\"\n    diagnosticsHttpResponse \"Response\"\n    diagnosticsHttpUnified \"Unified link notation\"\n    diagnosticsHttpStatus \"HTTP {status} · {elapsed} ms · {bytes} B\"\n    diagnosticsHttpEmpty \"No outbound HTTP requests recorded for this turn.\"\n    diagnosticsProviders \"Search providers tried\"\n    diagnosticsProviderRow \"{label}: {status} · {count} results · {elapsed} ms\"\n    diagnosticsProviderOk \"ok\"\n    diagnosticsProviderError \"error\"\n  fetch\n    collapse \"Collapse\"\n    expand \"Expand\"\n    fullscreen \"Full screen\"\n    minimize \"Minimize\"\n    openInNewTab \"Open in new tab\"\n    frameTitle \"Previewed page: {url}\"\n  memory\n    exportTriggered \"Triggered Export memory. Your browser is downloading `formal-ai-memory.lino`.\"\n    importTriggered \"Triggered Import memory. Pick a `.lino` file in the open dialog to restore the saved memory.\"\n    resetCancelled \"Reset memory cancelled.\"\n  confirm\n    resetMemoryExportFirst \"Export memory first? OK exports a backup and cancels reset. Cancel continues to the irreversible confirmation.\"\n    resetMemory \"Reset memory is irreversible and permanently deletes the local event log. Continue?\"\n    purgeDeletedExportFirst \"Export memory first? OK exports a backup and cancels permanent deletion. Cancel continues to the irreversible confirmation.\"\n    purgeDeleted \"This irreversible action permanently deletes every event from deleted conversations. Continue?\"\n    deleteConversationPermanentExportFirst \"Export memory first? OK exports a backup and cancels permanent deletion. Cancel continues to the irreversible confirmation.\"\n    deleteConversationPermanent \"This irreversible action permanently deletes this conversation from memory. Continue?\"\n  sidebar\n    conversations \"Conversations\"\n    menu \"Menu\"\n    examplePrompts \"Example prompts\"\n    tools \"Tools\"\n    trace \"Trace\"\n    settings \"Settings\"\n  settings\n    ambiguity \"Ambiguity\"\n    moreQuestions \"More questions\"\n    moreGuessing \"More guessing\"\n    followUpInitiative \"Follow-up initiative\"\n    userInitiative \"User initiative\"\n    assistantInitiative \"Assistant proposes\"\n    temperature \"Temperature\"\n    deterministic \"Deterministic\"\n    varied \"Varied\"\n    variations \"Greeting variations\"\n    definitionFusion\n      label \"Definition fusion\"\n      explicit \"Explicit only\"\n      auto \"Auto for definitions\"\n    blueprintComposition\n      label \"Program composition\"\n      composed \"Composed (projected)\"\n      documented \"Documented (full)\"\n    thinkingDetail\n      label \"Thinking detail\"\n      brief \"Brief\"\n      standard \"Standard\"\n      detailed \"Detailed\"\n    experimentalOcr\n      label \"Experimental OCR\"\n      warning \"Downloads about 6 MB on first use: OCR wrapper, worker, WebAssembly core, and English traineddata.\"\n    externalServices\n      label \"External trusted services\"\n      note \"Choose which trusted services the assistant may consult for procedural how-to answers and project lookups. Each one is on by default; turn off any you would rather not contact.\"\n    externalServiceWikihow\n      label \"wikiHow procedures\"\n    externalServiceStackExchange\n","exit_code":0,"status":"completed"}}
