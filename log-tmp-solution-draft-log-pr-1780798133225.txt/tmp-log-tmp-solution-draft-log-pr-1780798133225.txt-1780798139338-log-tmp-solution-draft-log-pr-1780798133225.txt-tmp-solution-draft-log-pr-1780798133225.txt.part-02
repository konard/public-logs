[2026-06-07T01:59:20.941Z] [INFO] +export function decodeLinoValue(rawValue) {
[2026-06-07T01:59:20.941Z] [INFO] +  const value = (rawValue ?? '').trim();
[2026-06-07T01:59:20.941Z] [INFO] +  if (value.length === 0) return '';
[2026-06-07T01:59:20.941Z] [INFO] +
[2026-06-07T01:59:20.941Z] [INFO] +  if (value.startsWith('"')) {
[2026-06-07T01:59:20.941Z] [INFO] +    return JSON.parse(value);
[2026-06-07T01:59:20.941Z] [INFO] +  }
[2026-06-07T01:59:20.941Z] [INFO] +
[2026-06-07T01:59:20.941Z] [INFO] +  if (value.startsWith("'") && value.endsWith("'")) {
[2026-06-07T01:59:20.941Z] [INFO] +    return value.slice(1, -1);
[2026-06-07T01:59:20.941Z] [INFO] +  }
[2026-06-07T01:59:20.941Z] [INFO] +
[2026-06-07T01:59:20.941Z] [INFO] +  if (value === 'unformalized-raw') {
[2026-06-07T01:59:20.941Z] [INFO] +    return '';
[2026-06-07T01:59:20.941Z] [INFO] +  }
[2026-06-07T01:59:20.941Z] [INFO] +
[2026-06-07T01:59:20.941Z] [INFO] +  if (value.startsWith('unformalized-raw ')) {
[2026-06-07T01:59:20.941Z] [INFO] +    const codePoints = value
[2026-06-07T01:59:20.941Z] [INFO] +      .slice('unformalized-raw '.length)
[2026-06-07T01:59:20.941Z] [INFO] +      .trim()
[2026-06-07T01:59:20.941Z] [INFO] +      .split(/\s+/)
[2026-06-07T01:59:20.941Z] [INFO] +      .filter(Boolean)
[2026-06-07T01:59:20.941Z] [INFO] +      .map((entry) => {
[2026-06-07T01:59:20.941Z] [INFO] +        const codePoint = Number(entry);
[2026-06-07T01:59:20.941Z] [INFO] +        if (!Number.isInteger(codePoint)) {
[2026-06-07T01:59:20.941Z] [INFO] +          throw new Error(`Invalid unformalized-raw code point: ${entry}`);
[2026-06-07T01:59:20.941Z] [INFO] +        }
[2026-06-07T01:59:20.941Z] [INFO] +        return codePoint;
[2026-06-07T01:59:20.941Z] [INFO] +      });
[2026-06-07T01:59:20.941Z] [INFO] +    return String.fromCodePoint(...codePoints);
[2026-06-07T01:59:20.941Z] [INFO] +  }
[2026-06-07T01:59:20.941Z] [INFO] +
[2026-06-07T01:59:20.941Z] [INFO] +  return value;
[2026-06-07T01:59:20.941Z] [INFO] +}
[2026-06-07T01:59:20.941Z] [INFO] +
[2026-06-07T01:59:20.941Z] [INFO] +export function parseLinoEntry(line, indent, keyword) {
[2026-06-07T01:59:20.941Z] [INFO] +  const pattern = new RegExp(`^ {${indent}}${keyword}(?:\\s+(.+))?$`);
[2026-06-07T01:59:20.941Z] [INFO] +  const match = line.match(pattern);
[2026-06-07T01:59:20.941Z] [INFO] +  if (!match) return null;
[2026-06-07T01:59:20.941Z] [INFO] +  return decodeLinoValue(match[1] ?? '');
[2026-06-07T01:59:20.941Z] [INFO] +}
[2026-06-07T01:59:20.941Z] [INFO] +
[2026-06-07T01:59:20.941Z] [INFO] +export function parseLinoField(line, indent) {
[2026-06-07T01:59:20.941Z] [INFO] +  const pattern = new RegExp(`^ {${indent}}([a-z_][a-z0-9_]*)(?:\\s+(.+))?$`);
[2026-06-07T01:59:20.941Z] [INFO] +  const match = line.match(pattern);
[2026-06-07T01:59:20.941Z] [INFO] +  if (!match) return null;
[2026-06-07T01:59:20.941Z] [INFO] +  return { key: match[1], value: decodeLinoValue(match[2] ?? '') };
[2026-06-07T01:59:20.941Z] [INFO] +}
[2026-06-07T01:59:20.941Z] [INFO] +
[2026-06-07T01:59:20.941Z] [INFO] +export function parseSupportedLanguagesFromAgentInfo(text) {
[2026-06-07T01:59:20.941Z] [INFO] +  let inSupportedLanguagesField = false;
[2026-06-07T01:59:20.941Z] [INFO] +
[2026-06-07T01:59:20.941Z] [INFO] +  for (const line of text.split(/\r?\n/)) {
[2026-06-07T01:59:20.941Z] [INFO] +    const field = parseLinoEntry(line, 2, 'field');
[2026-06-07T01:59:20.941Z] [INFO] +    if (field !== null) {
[2026-06-07T01:59:20.941Z] [INFO] +      inSupportedLanguagesField = field === 'supported_languages';
[2026-06-07T01:59:20.941Z] [INFO] +      continue;
[2026-06-07T01:59:20.941Z] [INFO] +    }
[2026-06-07T01:59:20.941Z] [INFO] +
[2026-06-07T01:59:20.941Z] [INFO] +    if (!inSupportedLanguagesField) continue;
[2026-06-07T01:59:20.941Z] [INFO] +
[2026-06-07T01:59:20.941Z] [INFO] +    const value = parseLinoEntry(line, 4, 'value');
[2026-06-07T01:59:20.941Z] [INFO] +    if (value !== null) {
[2026-06-07T01:59:20.941Z] [INFO] +      return value.split('|').filter(Boolean);
[2026-06-07T01:59:20.941Z] [INFO] +    }
[2026-06-07T01:59:20.941Z] [INFO] +  }
[2026-06-07T01:59:20.941Z] [INFO] +
