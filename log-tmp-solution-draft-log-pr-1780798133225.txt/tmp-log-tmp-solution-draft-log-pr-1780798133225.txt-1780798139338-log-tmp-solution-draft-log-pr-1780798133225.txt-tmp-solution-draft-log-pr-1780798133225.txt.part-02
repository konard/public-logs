[2026-06-07T01:59:22.767Z] [INFO] +export function decodeLinoValue(rawValue) {
[2026-06-07T01:59:22.767Z] [INFO] +  const value = (rawValue ?? '').trim();
[2026-06-07T01:59:22.767Z] [INFO] +  if (value.length === 0) return '';
[2026-06-07T01:59:22.767Z] [INFO] +
[2026-06-07T01:59:22.767Z] [INFO] +  if (value.startsWith('"')) {
[2026-06-07T01:59:22.767Z] [INFO] +    return JSON.parse(value);
[2026-06-07T01:59:22.767Z] [INFO] +  }
[2026-06-07T01:59:22.767Z] [INFO] +
[2026-06-07T01:59:22.767Z] [INFO] +  if (value.startsWith("'") && value.endsWith("'")) {
[2026-06-07T01:59:22.767Z] [INFO] +    return value.slice(1, -1);
[2026-06-07T01:59:22.767Z] [INFO] +  }
[2026-06-07T01:59:22.767Z] [INFO] +
[2026-06-07T01:59:22.767Z] [INFO] +  if (value === 'unformalized-raw') {
[2026-06-07T01:59:22.767Z] [INFO] +    return '';
[2026-06-07T01:59:22.767Z] [INFO] +  }
[2026-06-07T01:59:22.767Z] [INFO] +
[2026-06-07T01:59:22.767Z] [INFO] +  if (value.startsWith('unformalized-raw ')) {
[2026-06-07T01:59:22.767Z] [INFO] +    const codePoints = value
[2026-06-07T01:59:22.767Z] [INFO] +      .slice('unformalized-raw '.length)
[2026-06-07T01:59:22.767Z] [INFO] +      .trim()
[2026-06-07T01:59:22.767Z] [INFO] +      .split(/\s+/)
[2026-06-07T01:59:22.767Z] [INFO] +      .filter(Boolean)
[2026-06-07T01:59:22.767Z] [INFO] +      .map((entry) => {
[2026-06-07T01:59:22.767Z] [INFO] +        const codePoint = Number(entry);
[2026-06-07T01:59:22.767Z] [INFO] +        if (!Number.isInteger(codePoint)) {
[2026-06-07T01:59:22.767Z] [INFO] +          throw new Error(`Invalid unformalized-raw code point: ${entry}`);
[2026-06-07T01:59:22.767Z] [INFO] +        }
[2026-06-07T01:59:22.767Z] [INFO] +        return codePoint;
[2026-06-07T01:59:22.767Z] [INFO] +      });
[2026-06-07T01:59:22.767Z] [INFO] +    return String.fromCodePoint(...codePoints);
[2026-06-07T01:59:22.767Z] [INFO] +  }
[2026-06-07T01:59:22.767Z] [INFO] +
[2026-06-07T01:59:22.767Z] [INFO] +  return value;
[2026-06-07T01:59:22.767Z] [INFO] +}
[2026-06-07T01:59:22.767Z] [INFO] +
[2026-06-07T01:59:22.767Z] [INFO] +export function parseLinoEntry(line, indent, keyword) {
[2026-06-07T01:59:22.767Z] [INFO] +  const pattern = new RegExp(`^ {${indent}}${keyword}(?:\\s+(.+))?$`);
[2026-06-07T01:59:22.767Z] [INFO] +  const match = line.match(pattern);
[2026-06-07T01:59:22.767Z] [INFO] +  if (!match) return null;
[2026-06-07T01:59:22.767Z] [INFO] +  return decodeLinoValue(match[1] ?? '');
[2026-06-07T01:59:22.767Z] [INFO] +}
[2026-06-07T01:59:22.767Z] [INFO] +
[2026-06-07T01:59:22.767Z] [INFO] +export function parseLinoField(line, indent) {
[2026-06-07T01:59:22.767Z] [INFO] +  const pattern = new RegExp(`^ {${indent}}([a-z_][a-z0-9_]*)(?:\\s+(.+))?$`);
[2026-06-07T01:59:22.767Z] [INFO] +  const match = line.match(pattern);
[2026-06-07T01:59:22.767Z] [INFO] +  if (!match) return null;
[2026-06-07T01:59:22.767Z] [INFO] +  return { key: match[1], value: decodeLinoValue(match[2] ?? '') };
[2026-06-07T01:59:22.767Z] [INFO] +}
[2026-06-07T01:59:22.767Z] [INFO] +
[2026-06-07T01:59:22.767Z] [INFO] +export function parseSupportedLanguagesFromAgentInfo(text) {
