[2026-05-10T14:08:19.554Z] [INFO] {"type":"item.started","item":{"id":"item_410","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' e2e/tables-workspace.spec.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
